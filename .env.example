# OpenCode AI Workspace Environment Configuration
# Salin file ini ke .env sebelum menjalankan workspace: cp .env.example .env

# Token Autentikasi GitHub untuk MCP Integration
# Dapatkan token Anda di: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Kunci API untuk Agen AI (Opsional jika menggunakan endpoint lokal/proxy)
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
CLAUDE_API_KEY=your_claude_key_here

# Informasi Kontak Developer
DEVELOPER_EMAIL=andi.upn@gmail.com
DEVELOPER_WEBSITE=https://kuncimu.com
